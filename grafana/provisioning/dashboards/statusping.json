{
  "title": "StatusPing",
  "uid": "statusping",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Endpoints Up",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(endpoint_up)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Endpoint Up (1 = up)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [{ "expr": "endpoint_up", "legendFormat": "{{endpoint}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency (s)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(endpoint_latency_seconds_bucket[5m])))",
        "legendFormat": "{{endpoint}}", "refId": "A"
      }]
    }
  ]
}
